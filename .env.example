# These are process environment variables. The Node server does not load .env files automatically.
# Linux production services can use deploy/wenku-archive.service and an EnvironmentFile.
ARCHIVE_PORT=4178
# Public deployment requires both variables below; keep the real auth file private.
# ARCHIVE_PUBLIC_ORIGIN=https://books.example.org
# ARCHIVE_AUTH_FILE=/home/archive/.local/share/wenku-archive/secrets/admin-auth.json
# Optional separate data locations:
# ARCHIVE_LIBRARY=/home/archive/.local/share/wenku-archive/library
# ARCHIVE_QUEUE=/home/archive/.local/share/wenku-archive/download-queue.json
# ARCHIVE_STATE_DIR=/home/archive/.local/share/wenku-archive/.state
# Build-time URL prefix, for example /wenku/ when sharing an existing web host:
# ARCHIVE_BASE_PATH=/wenku/
