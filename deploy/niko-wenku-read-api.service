[Unit]
Description=Niko Wenku read-only fallback API (no workers)
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=/srv/niko-archive/services/wenku-read-api/current
EnvironmentFile=/etc/niko-wenku-read-api/server.env
ExecStart=/usr/bin/node server/read-api.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@LIBRARY_ROOT@
ReadWritePaths=/var/lib/niko-wenku-read-api

[Install]
WantedBy=multi-user.target
