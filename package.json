{
  "name": "wenku-archive",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "nikowenku-archive": "./scripts/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "prebuild": "npm run package:cli",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "archive": "node scripts/cli.mjs",
    "package:cli": "node scripts/package-cli.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "publish:book": "node scripts/publish-book.mjs",
    "download:full": "node scripts/download-full.mjs",
    "source:wenku8": "node scripts/import-wenku8.mjs",
    "download:watch": "node scripts/watch-library.mjs",
    "download:start": "node scripts/watch-library.mjs --background",
    "download:status": "node scripts/watch-library.mjs --status",
    "download:stop": "node scripts/watch-library.mjs --stop",
    "covers:backfill": "node scripts/backfill-covers.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.5"
  }
}
